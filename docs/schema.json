{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spherex-sky-diary.nasa/schemas/v1.0/candidates.json",
  "title": "SPHEREx Sky Diary Candidates Contract",
  "description": "Unified JSON contract for moving object detections, tracks, and spectra in SPHEREx sky patches.",
  "type": "object",
  "required": [
    "schema_version",
    "region",
    "epochs",
    "movers"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0",
      "description": "Semantic schema contract version. Must be 1.0."
    },
    "data_version": {
      "type": "string",
      "description": "Version identifier for the data release or pipeline run."
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of when this candidate catalog was produced."
    },
    "fov_deg": {
      "type": "number",
      "exclusiveMinimum": 0.0,
      "description": "Field of view diameter/width in degrees for the patch."
    },
    "region": {
      "type": "object",
      "required": [
        "name",
        "ra_center",
        "dec_center",
        "radius_deg"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Human-readable label or target identifier for the sky patch."
        },
        "ra_center": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 360.0,
          "description": "Right Ascension center coordinate (J2000) in degrees."
        },
        "dec_center": {
          "type": "number",
          "minimum": -90.0,
          "maximum": 90.0,
          "description": "Declination center coordinate (J2000) in degrees."
        },
        "radius_deg": {
          "type": "number",
          "exclusiveMinimum": 0.0,
          "description": "Angular radius of the region in degrees."
        }
      },
      "additionalProperties": false
    },
    "epochs": {
      "type": "array",
      "minItems": 1,
      "description": "List of SPHEREx observation epochs covered in this sky patch.",
      "items": {
        "type": "object",
        "required": [
          "epoch_id",
          "date",
          "band_count"
        ],
        "properties": {
          "epoch_id": {
            "type": "string",
            "description": "Unique identifier for the observation epoch."
          },
          "date": {
            "type": "string",
            "format": "date-time",
            "description": "Observation date and time in ISO 8601 format."
          },
          "band_count": {
            "type": "integer",
            "minimum": 1,
            "description": "Number of spectral channels / bands observed in this epoch."
          }
        },
        "additionalProperties": false
      }
    },
    "movers": {
      "type": "array",
      "description": "Detected moving objects within the region across observation epochs.",
      "items": {
        "type": "object",
        "required": [
          "object_id",
          "ra",
          "dec",
          "type",
          "match_name",
          "confidence",
          "is_synthetic",
          "motion",
          "detections",
          "spectrum"
        ],
        "properties": {
          "object_id": {
            "type": "string",
            "description": "Unique identifier for the moving object candidate."
          },
          "ra": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 360.0,
            "description": "Current or reference Right Ascension in degrees."
          },
          "dec": {
            "type": "number",
            "minimum": -90.0,
            "maximum": 90.0,
            "description": "Current or reference Declination in degrees."
          },
          "type": {
            "type": "string",
            "enum": [
              "known",
              "unknown"
            ],
            "description": "Mover classification: known solar system body or newly discovered unknown mover."
          },
          "match_name": {
            "type": [
              "string",
              "null"
            ],
            "description": "Catalog or MPC designation if known, or null if unknown."
          },
          "confidence": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0,
            "description": "Classification or detection confidence score between 0.0 and 1.0."
          },
          "is_synthetic": {
            "type": "boolean",
            "description": "True if synthetic/mock data. Mandates 'TEST DATA' badge in the UI."
          },
          "motion": {
            "type": "object",
            "required": [
              "ra_rate_arcsec_per_day",
              "dec_rate_arcsec_per_day"
            ],
            "properties": {
              "ra_rate_arcsec_per_day": {
                "type": "number",
                "description": "Apparent motion rate in RA in arcseconds per day (dRA/dt * cos(dec))."
              },
              "dec_rate_arcsec_per_day": {
                "type": "number",
                "description": "Apparent motion rate in Dec in arcseconds per day (dDec/dt)."
              }
            },
            "additionalProperties": false
          },
          "detections": {
            "type": "array",
            "minItems": 1,
            "description": "Individual epoch detections constituting the mover's trajectory.",
            "items": {
              "type": "object",
              "required": [
                "epoch_id",
                "date",
                "ra",
                "dec",
                "flux",
                "cutout_url"
              ],
              "properties": {
                "epoch_id": {
                  "type": "string",
                  "description": "ID of the epoch corresponding to this detection."
                },
                "date": {
                  "type": "string",
                  "format": "date-time",
                  "description": "Detection timestamp in ISO 8601 format."
                },
                "ra": {
                  "type": "number",
                  "minimum": 0.0,
                  "maximum": 360.0,
                  "description": "Measured RA in degrees at this epoch."
                },
                "dec": {
                  "type": "number",
                  "minimum": -90.0,
                  "maximum": 90.0,
                  "description": "Measured Dec in degrees at this epoch."
                },
                "flux": {
                  "type": "number",
                  "description": "Integrated or peak measured flux (in arbitrary or physical units, e.g. uJy)."
                },
                "cutout_url": {
                  "type": "string",
                  "description": "Relative URL or path to the postage-stamp cutout image."
                }
              },
              "additionalProperties": false
            }
          },
          "spectrum": {
            "description": "Extracted SPHEREx spectrum for this mover, or null if unextracted.",
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "wavelength_um",
                  "flux",
                  "flux_err"
                ],
                "properties": {
                  "wavelength_um": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "description": "Array of wavelengths in micrometers (0.75 - 5.0 um)."
                  },
                  "flux": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "description": "Calibrated spectral flux array."
                  },
                  "flux_err": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "description": "1-sigma uncertainty per spectral channel."
                  }
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
